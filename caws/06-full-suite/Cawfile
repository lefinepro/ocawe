# 06 - Full Suite
#
# Complete feature demonstration: multiple workflows, service workflows,
# agents, skills, tools, voice, RAG, external execution, and suspend for
# human-in-the-loop approval.

settings do
  data.adapter = "memory"
  port = 4111
end

container do
  packages = ["git", "curl", "jq"]
  files = ["agents", "skills", "tools"]
end

struct FullSuiteInput
  include JSON::Serializable
  getter task : String?
  getter text : String?
  getter audio : String?
end

struct FullSuiteOutput
  include JSON::Serializable
  getter last_response : String?
  getter status : String?
end

@[Validate(FullSuiteInput, FullSuiteOutput)]
workflow "06-full-suite" do
  # Primary agent with schema validation
  agent "full-agent", input_schema: schema_ref("input"), output_schema: schema_ref("output")

  # Skill execution tied to agent
  skill "full-skill", agent: "full-agent"

  # Custom agents with various configurations
  agent "opencode-agent", input_schema: Schema::Types.any(), output_schema: Schema::Types.any()
  agent "main-agent", input_schema: Schema::Types.any(), output_schema: Schema::Types.any()

  # External script execution with runtime metadata
  exec "tools/echo-json.sh", runtime: {shell: "bash"}

  # Voice processing
  voice "voice-step", config: {provider: "openai", speaker: "alloy"}

  # RAG query
  rag "rag-step", config: {operation: "query", vectorStoreName: "memory", indexName: "full-suite-index", topK: 3}

  # Human-in-the-loop approval
  suspend "manual-approval", reason: "Confirm run output"
end

@[Service]
@[Validate(FullSuiteInput, FullSuiteOutput)]
workflow "06-full-suite-daemon" do
  # Service workflow starts with `ocawe up` and can host a tunnel, daemon, or watcher.
  exec "tools/echo-json.sh", runtime: {shell: "bash"}
end

@[Service]
@[Validate(FullSuiteInput, FullSuiteOutput)]
workflow "06-full-suite-watch" do
  # Second service workflow demonstrates multiple runtime-started helpers in one bundle.
  exec "tools/echo-json.sh", runtime: {shell: "bash"}
end
