#+name: tagger

require "json"
require "./plugins/registry"

settings do
  data.adapter = "memory"
  port = 4112
  federation.local_actor = "http://tagger:4112/actors/tagger"
  federation.signatures_required = false
  federation.s2s_poll_interval_seconds = 15
  federation.s2s_http_timeout_seconds = 20
end

container do
  files = ["."]
end

struct TaggerInput
  include JSON::Serializable
  include Api::Federation::Inbox
  property activity : JSON::Any?
  property prompt : String?
  property labels : Array(String)?
end

struct TaggerOutput
  include JSON::Serializable
  include Api::Federation::Outbox
  property tags : Array(String)?
  property confidence : Float64?
  property route : String?
  property model_hints : Array(String)?
  property agent_hints : Array(String)?
  property fmatch_posted : Bool?
  property fmatch_response : JSON::Any?
  property fmatch_proposal : JSON::Any?
end

#+description: Fmatch tagger for agent and model matching hints
#+tags: fmatch; tagger; model-routing; typesense
@[Validate(TaggerInput, TaggerOutput)]
workflow "tagger" do
  follow ["@planner@fmatch.internal.fedi"]
  tagger
end
