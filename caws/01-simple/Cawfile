# 01 - Simple Agent
#
# Demonstrates the simplest possible agent setup.
# Runs agent with default model.

settings do
  data.adapter = "memory"
  port = 4111
end

struct InputSimple
  include Api::OpenResponses::Request
  include Api::MastraAPI::Request
  include Api::ChatCompletionAPI::Request
end

struct OutputSimple
  include Api::OpenResponses::Response
  include Api::MastraAPI::Response
  include Api::ChatCompletionAPI::Response
end


@[Validate(InputSimple, OutputSimple)]
@[Model(Kimi)]
workflow "01-simple" do
  agent "assistant"
end
