# Orator - OpenAI API to ActivityPub Gateway
# Full replacement for crater-openai using Ocawe framework

settings do
  data.adapter = "memory"
  port = 8080
end

# Input accepts both OpenResponses and ChatCompletion formats
struct InputSchema
  include Api::OpenResponses::Request
  include Api::ChatCompletionAPI::Request
end

# Output provides both OpenResponses and ChatCompletion formats
struct OutputSchema
  include Api::OpenResponses::Response
  include Api::ChatCompletionAPI::Response
end

# Main workflow that bridges OpenAI APIs with ActivityPub
@[Validate(InputSchema, OutputSchema)]
workflow "orator" do
  # Follow remote actors for ActivityPub federation
  follow ["@actra@lefine.pro"]
  
  # Convert incoming OpenAI request to ActivityPub and send to inbox
  # send_to_inbox
  
  # Receive ActivityPub responses from outbox and convert back to OpenAI format
  # recevie_from_outbox
end

