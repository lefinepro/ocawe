# 03 - Control Flow Example
#
# Demonstrates Crystal-native control flow: if/elsif/else, unless, parallel, while, until.

settings do
  data.adapter = "memory"
  port = 4111
end

struct ControlFlowInput
  include JSON::Serializable
  getter skip_preprocessing : Bool?
  getter needs_translation : Bool?
end

struct ControlFlowOutput
  include JSON::Serializable
  getter last_response : String?
end

@[Model("openai/gpt-4.1")]
@[Validate(ControlFlowInput, ControlFlowOutput)]
workflow "03-control-flow" do
  # Execute agent unless condition is true
  unless input.skip_preprocessing
    agent "preprocessor"
  end

  # Sequential agent
  agent "analyzer"

  # Conditional with if/else
  if input.needs_translation
    agent "translator"
  else
    agent "passthrough"
  end

  # Parallel execution
  parallel do
    agent "validator"
    agent "formatter"
  end

  # Final agent
  agent "finalizer"
end
