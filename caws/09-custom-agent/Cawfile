# 09 - Custom Agent (Binary)
#
# Demonstrates how to write a custom coding agent that calls an external binary.
# This is the recommended way to add coding agents — as executable commands
# with their own model configuration.

settings do
  data.adapter = "memory"
  port = 4111
end

import = [
  "./agents/*.md"
]

@[Model("cliproxy")]
workflow "09-custom-agent" do
  agent "my-coder"
end
