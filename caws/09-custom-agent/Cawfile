# 09 - Custom Agent (Binary)
#
# Demonstrates how to write a custom agent that calls an external binary.
# This is the recommended way to add agents — as executable commands
# with their own model configuration.

settings do
  data.adapter = "memory"
  port = 4111
end

struct CustomAgentInput
  include JSON::Serializable
  getter prompt : String?
  getter input : JSON::Any?
end

struct CustomAgentOutput
  include JSON::Serializable
  getter last_response : String?
end

@[Model("openai/gpt-4.1-mini")]
@[Validate(CustomAgentInput, CustomAgentOutput)]
workflow "09-custom-agent" do
  input_type CustomAgentInput
  output_type CustomAgentOutput

  input_validate Schema::Types.object({
    "prompt" => Schema::Types.optional(Schema::Types.of(String)),
    "input" => Schema::Types.optional(Schema::Types.any()),
  }, strict: false)
  output_validate Schema::Types.object({
    "last_response" => Schema::Types.optional(Schema::Types.of(String)),
  }, strict: false)

  agent "my-coder"
end
