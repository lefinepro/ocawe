# 04 - RAG Assistant
#
# Demonstrates Retrieval-Augmented Generation with agents.
# Ingests code documentation, queries it for context-aware answers.

settings do
  data.adapter = "memory"
  port = 4111
end

struct RagInput
  include JSON::Serializable
  getter text : String?
  getter query : String?
end

struct RagOutput
  include JSON::Serializable
  getter answer : String?
end

@[Model("openai/gpt-4.1-mini")]
@[Validate(RagInput, RagOutput)]
workflow "04-rag-assistant" do
  # Ingest documentation into vector store
  skill "rag-ingest-skill"
  rag "rag-ingest", config: {operation: "upsert", vectorStoreName: "memory", indexName: "rag-assistant-index"}

  # Query for context-aware answers
  skill "rag-query-skill"
  rag "rag-query", config: {operation: "query", vectorStoreName: "memory", indexName: "rag-assistant-index", topK: 5}
end
