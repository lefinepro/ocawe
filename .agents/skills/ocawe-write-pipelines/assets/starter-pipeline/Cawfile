settings do
  data.adapter = "memory"
  port = 4111
end

container do
  packages = []
  files = ["plugins/functions"]
end

struct ReproduciblePipelineInput
  include JSON::Serializable
  getter input : String?
end

struct ReproduciblePipelineOutput
  include JSON::Serializable
  getter text : String?
  getter status : String?
end

@[Validate(ReproduciblePipelineInput, ReproduciblePipelineOutput)]
workflow "reproducible-pipeline" do
  pass_input
end

test "returns its input" do
  assert "reproducible-pipeline", input: "example", equality: "example"
end
